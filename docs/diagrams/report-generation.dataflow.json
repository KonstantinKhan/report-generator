        "note": "report-server принимает задание, report-loodsman идёт в PDM, report-data превращает DTO в записи item.*"
      },
      {
        "id": "two-ir-boundary",
        "label": "Смысл и раскладка",
        "focus": [
          "template",
          "builder",
          "ir",
          "layout",
          "layoutir"
        ],
        "note": "report-ir хранит смысл без координат, report-layout считает физику, report-layout-ir хранит результат."
      },
      {
        "id": "render-from-layout-ir",
        "label": "Рендер из Layout IR",
        "focus": [
          "layoutir",
          "renders"
