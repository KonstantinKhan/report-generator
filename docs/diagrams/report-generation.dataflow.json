      "id": "pdm_dto",
      "from": "pdm",
      "to": "mapper",
      "label": "SpecificationDto"
    },
    {
      "id": "mapper_records",
      "from": "mapper",
      "to": "builder",
      "label": "SpecificationData"
    },
    {
      "id": "template_flow",
      "from": "template",
      "to": "builder",
      "label": "FlowTableSpec",
      "route": "straight",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "builder_table",
      "from": "builder",
      "to": "ir",
      "label": "IrTable"
    },
    {
      "id": "ir_document",
      "from": "ir",
      "to": "layout",
      "label": "IrDocument",
      "route": "straight",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "layout_document",
      "from": "layout",
      "to": "layoutir",
      "label": "LaidOutDocument"
    },
    {
      "id": "layoutir_render",
      "from": "layoutir",
      "to": "renders",
      "label": "Layout IR",
      "route": "straight",
      "fromSide": "top",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Вход и данные",
      "items": [
        "report-server — приём POST /specifications/{versionId}, оркестрация пайплайна",
        "report-loodsman — сессия Loodsman, PdmClient поверх REST API v4",
        "report-data — маппинг SpecificationDto в типизированные записи item.*"
      ]
    },
    {
      "dot": "emerald",
      "title": "Документ: смысл",
      "items": [
        "YAML-шаблон — ЧТО рисовать: рамка, штамп, шапка, колонки, правила",
        "Report Builder — схема и значения DataContext, сборка IrDocument",
        "Semantic IR (report-ir) — смысл без координат: колонки, группы, нумерация, итоги",
        "TemplateContract — опечатка в bind это ошибка до раскладки"
      ]
    },
    {
      "dot": "amber",
      "title": "Раскладка и выход",
      "items": [
        "Layout Engine (report-layout) — код: измеряет текст, переносит, режет страницы, нумерует строки",
        "Layout IR (report-layout-ir) — данные: результат раскладки, готовые страницы и координаты",
        "Раскладка считается один раз; рендереры только рисуют готовый Layout IR",
        "Третий рендерер (XLSX) не тронет ни report-ir, ни report-layout"
      ]
    }
  ]
}
